# Inactive factory template: no image recipe, enable target or runtime provisioning.
[Unit]
Description=Explicit one-use initialization receipt IPC
Wants=inkyos-admission-prepare.service inkyos-factory-supervisor.service
After=local-fs.target inkyos-admission-prepare.service inkyos-factory-supervisor.service

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=10s
User=root
Group=inky-provisioning
SupplementaryGroups=root
UMask=0077
ExecStart=/usr/bin/python3.13 -I -B -S /usr/lib/inkyos/writer-launcher.py ipc
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=infinity
SendSIGKILL=no
Restart=no
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=-/var/lib/inkyos/initialization /run/inkyos-bootstrap

# No Install/RuntimeDirectory/StateDirectory: preserve admission and writer locks.
